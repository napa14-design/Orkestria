rules_version = '2';

// Nenhum acesso direto do navegador: todo dado passa pelo servidor (rotas em
// app/api → services → DataSource com o Admin SDK, que não passa por aqui).
// Versionado em 23/10/2026, igual ao que já valia em produção: a chave web é
// pública (login com Google), então estas regras são a porta das coleções.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
