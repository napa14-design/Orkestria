# ── Fonte de dados ───────────────────────────────────────────────
# "memory"   → dados de demonstração em memória (não precisa de credenciais)
# "sheets"   → Google Sheets via service account (banco provisório)
# "firebase" → Firebase Firestore (banco definitivo)
DATA_SOURCE=memory

# ── Firebase (obrigatório apenas quando DATA_SOURCE=firebase) ────
# Console Firebase → Configurações do projeto → Contas de serviço →
# Gerar nova chave privada (JSON). Quebras de linha da chave como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ── Google Sheets (obrigatório apenas quando DATA_SOURCE=sheets) ─
# ID da planilha (trecho da URL entre /d/ e /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# E-mail do service account (IAM → Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada do service account (JSON baixado). Manter as quebras
# de linha como \n dentro de aspas duplas.
GOOGLE_PRIVATE_KEY=""

# ── Autenticação ─────────────────────────────────────────────────
# Não existe senha compartilhada: cada pessoa faz o primeiro acesso com um
# código individual gerado em Sistema › Usuários (ou entra com Google).
# Segredo usado para assinar o cookie de sessão. Trocar em produção.
AUTH_SECRET=troque-este-segredo-em-producao
# Marque true quando o sistema estiver publicado atrás de HTTPS.
COOKIE_SECURE=false

# ── Envio de e-mail (opcional) ───────────────────────────────────
# Sem estas variáveis o sistema não envia nada e apenas mostra o código de
# primeiro acesso na tela — nada quebra. Com elas, o código também vai por
# e-mail para a pessoa.
# Google Workspace: host smtp.gmail.com, porta 587, usuário = o e-mail
# completo e SMTP_PASS = uma SENHA DE APLICATIVO (não a senha da conta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional: remetente exibido. Vazio = usa SMTP_USER.
SMTP_FROM=
# Endereço público do sistema, usado no link do e-mail.
APP_URL=

# ── Desenvolvimento (só tem efeito com DATA_SOURCE=memory) ───────
# O seed em memória não traz usuário nenhum. Preencha para ter um
# administrador local; deixe vazio e o modo memória sobe sem ninguém.
DEV_ADMIN_EMAIL=
DEV_ADMIN_SENHA=
